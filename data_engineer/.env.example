# Salin jadi .env (tidak masuk git) lalu isi. JANGAN commit key asli.
# Key gratis: aistudio.google.com > API Keys. Tiap orang pakai key sendiri (kuota dibagi per key).
GEMINI_API_KEY=isi_key_sendiri
# EMBED_PROVIDER=gemini            # gemini (default) | bge-m3 (model lokal, untuk perbandingan)
# GEMINI_EMBED_MODEL=gemini-embedding-2   # model yang dipakai vektor di repo; jangan diganti tanpa embed ulang
# GEMINI_EMBED_DIM=768             # 768 / 1536 / 3072 (dinormalisasi otomatis bila < 3072)

# Opsional, hanya bila vektor disimpan di Firestore (belum diputuskan tim):
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_PROJECT_ID=
# SEARCH_BACKEND=
